#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/Msg-forwarder-Go -config /etc/Msg-forwarder-Go/config.json
    procd_set_param user Msg-forwarder-Go
    procd_set_param group Msg-forwarder-Go
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_set_param limits core 0
    procd_close_instance
}
